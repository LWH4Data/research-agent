#!/bin/sh
set -eu

umask 077
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
CLI="$ROOT/.venv/bin/research-store"
MARKER="$ROOT/.research-agent-root"

fail() {
    echo "오류: $*" >&2
    exit 1
}

if [ -L "$MARKER" ] || [ ! -f "$MARKER" ] || \
   [ "$(cat "$MARKER")" != "research-agent-owned-root-v1" ]; then
    fail "research-agent 프로젝트 루트를 확인할 수 없습니다."
fi
if stat -f '%l' "$MARKER" >/dev/null 2>&1; then
    marker_links=$(stat -f '%l' "$MARKER")
else
    marker_links=$(stat -c '%h' "$MARKER")
fi
[ "$marker_links" = "1" ] || fail "프로젝트 루트 표시 파일이 하드 링크입니다."

if [ -L "$ROOT/.venv" ] || [ ! -d "$ROOT/.venv" ] || \
   [ "$(CDPATH= cd -- "$ROOT/.venv" 2>/dev/null && pwd -P)" != "$ROOT/.venv" ]; then
    echo "가상 환경 경로가 안전하지 않습니다. install.sh를 다시 실행하세요." >&2
    exit 1
fi

if [ ! -x "$CLI" ]; then
    echo "설치가 필요합니다: bash \"$ROOT/install.sh\"" >&2
    exit 1
fi

case "$(realpath "$CLI")" in
    "$ROOT"/*) ;;
    *)
        echo "실행 파일이 프로젝트 밖을 가리킵니다. install.sh를 다시 실행하세요." >&2
        exit 1
        ;;
esac

unset ENV BASH_ENV CODEX_HOME PYTHONPATH PYTHONHOME PYTHONPYCACHEPREFIX
unset PYTHONINSPECT PYTHONSTARTUP PYTHON_HISTORY
unset SSLKEYLOGFILE QLOGDIR

exec "$ROOT/.venv/bin/python" -I -S -B \
    "$ROOT/src/research_store/operation_guard.py" "$ROOT" "$CLI" "$@"
