#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../../../.." && pwd -P)
MARKER="$ROOT/.research-agent-root"
SANDBOX_HOME="${HOME:?사용자 홈 경로를 확인할 수 없습니다}/.codex/research-library-sandbox"
SANDBOX_CONFIG="$SANDBOX_HOME/config.toml"
SANDBOX_OWNER="$SANDBOX_HOME/.research-agent-owner"

if [ -L "$MARKER" ] || [ ! -f "$MARKER" ] || \
   [ "$(cat "$MARKER")" != "research-agent-owned-root-v1" ]; then
    echo "오류: research-agent 프로젝트 루트를 확인할 수 없습니다." >&2
    exit 1
fi

if [ -L "$SANDBOX_HOME" ] || [ ! -d "$SANDBOX_HOME" ] || \
   [ "$(CDPATH= cd -- "$SANDBOX_HOME" 2>/dev/null && pwd -P)" != "$SANDBOX_HOME" ]; then
    echo "오류: Research Library 샌드박스 설정이 안전하지 않습니다. install.sh를 다시 실행하세요." >&2
    exit 1
fi
if [ -L "$SANDBOX_CONFIG" ] || [ ! -f "$SANDBOX_CONFIG" ]; then
    echo "오류: Research Library 샌드박스 설정이 없습니다. install.sh를 다시 실행하세요." >&2
    exit 1
fi
if [ -L "$SANDBOX_OWNER" ] || [ ! -f "$SANDBOX_OWNER" ]; then
    echo "오류: Research Library 샌드박스 소유권을 확인할 수 없습니다. install.sh를 다시 실행하세요." >&2
    exit 1
fi
if stat -f '%l' "$SANDBOX_CONFIG" >/dev/null 2>&1; then
    config_links=$(stat -f '%l' "$SANDBOX_CONFIG")
else
    config_links=$(stat -c '%h' "$SANDBOX_CONFIG")
fi
[ "$config_links" = "1" ] || {
    echo "오류: Research Library 샌드박스 설정이 하드 링크입니다." >&2
    exit 1
}
if stat -f '%l' "$SANDBOX_OWNER" >/dev/null 2>&1; then
    owner_links=$(stat -f '%l' "$SANDBOX_OWNER")
else
    owner_links=$(stat -c '%h' "$SANDBOX_OWNER")
fi
[ "$owner_links" = "1" ] || {
    echo "오류: Research Library 샌드박스 소유권 표시가 하드 링크입니다." >&2
    exit 1
}
first_line=$(sed -n '1p' "$SANDBOX_CONFIG")
second_line=$(sed -n '2p' "$SANDBOX_CONFIG")
if [ "$first_line" != "# research-agent-registration-v1" ] || \
   [ "$second_line" != "# research-agent-root: $ROOT" ]; then
    echo "오류: Research Library 샌드박스 설정의 소유권을 확인할 수 없습니다." >&2
    exit 1
fi
owner_first_line=$(sed -n '1p' "$SANDBOX_OWNER")
owner_second_line=$(sed -n '2p' "$SANDBOX_OWNER")
if [ "$owner_first_line" != "# research-agent-registration-v1" ] || \
   [ "$owner_second_line" != "# research-agent-root: $ROOT" ]; then
    echo "오류: Research Library 샌드박스 폴더의 소유권을 확인할 수 없습니다." >&2
    exit 1
fi

CODEX=$(command -v codex 2>/dev/null || true)
if [ -z "$CODEX" ] || [ ! -x "$CODEX" ]; then
    echo "오류: Codex 실행 파일을 찾을 수 없습니다. Codex 앱을 최신 버전으로 업데이트하세요." >&2
    exit 1
fi

# Normal PDF storage/sync is one managed intake, including review handoff.
# Internal storage commands use the root launcher; an explicitly text-only
# public operation must say so, rather than silently omitting lifecycle intake.
case "${1-}" in
    sync|import-pdf)
        INTAKE_OPERATION=$1
        shift
        if [ "${1-}" = "--text-only" ]; then
            shift
            set -- "$INTAKE_OPERATION" "$@"
        else
            exec "$SCRIPT_DIR/research-review" submit "$@"
        fi
        ;;
esac

# Keep attachment transfer inside the exact launcher covered by the narrow
# execution rule. A caller-side shell pipeline does not match that rule as one
# allowed invocation and can accidentally nest the macOS sandbox.
if [ "$#" -eq 3 ] && [ "$1" = "import-pdf" ] && [ "$2" = "--attachment" ]; then
    exec "$ROOT/.venv/bin/python" -I -S -B "$ROOT/scripts/import_attachment.py" \
        --codex "$CODEX" --root "$ROOT" --sandbox-home "$SANDBOX_HOME" --path "$3"
fi

# Both native confirmation and explicit paths use the same host sequence.
# The helper registers through the root primitive, then submits exact sources.
if [ "${1-}" = "source-add" ]; then
    shift
    # The only host options available to callers are language and registration
    # mode. Trusted root, executable, profile, and installation controls never
    # come from the caller. After -- every argument stays literal path data.
    if [ "$#" -eq 1 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; }; then
        exec "$ROOT/.venv/bin/python" -I -S -B "$ROOT/scripts/select_sources.py" --help
    fi
    SOURCE_LANGUAGE=auto
    SOURCE_LANGUAGE_SET=false
    SOURCE_REGISTRATION_ONLY=false
    SOURCE_LITERAL_PATHS=false
    SOURCE_REMAINING=$#
    # Rotate retained paths behind the unprocessed arguments; the original
    # argument count keeps appended paths from being parsed a second time.
    while [ "$SOURCE_REMAINING" -gt 0 ]; do
        SOURCE_ARGUMENT=$1
        shift
        SOURCE_REMAINING=$((SOURCE_REMAINING - 1))
        if [ "$SOURCE_LITERAL_PATHS" = true ]; then
            set -- "$@" "$SOURCE_ARGUMENT"
            continue
        fi
        case "$SOURCE_ARGUMENT" in
            --)
                SOURCE_LITERAL_PATHS=true ;;
            --language|--language=*)
                if [ "$SOURCE_LANGUAGE_SET" = true ]; then
                    echo "Error: source-add accepts --language only once." >&2
                    exit 2
                fi
                SOURCE_LANGUAGE_SET=true
                if [ "$SOURCE_ARGUMENT" = "--language" ]; then
                    if [ "$SOURCE_REMAINING" -eq 0 ]; then
                        echo "Error: --language requires auto, ko, or en." >&2
                        exit 2
                    fi
                    SOURCE_LANGUAGE=$1
                    shift
                    SOURCE_REMAINING=$((SOURCE_REMAINING - 1))
                else
                    SOURCE_LANGUAGE=${SOURCE_ARGUMENT#--language=}
                fi
                case "$SOURCE_LANGUAGE" in
                    auto|ko|en) ;;
                    *)
                        echo "Error: --language must be auto, ko, or en." >&2
                        exit 2 ;;
                esac ;;
            --registration-only)
                if [ "$SOURCE_REGISTRATION_ONLY" = true ]; then
                    echo "Error: source-add accepts --registration-only only once." >&2
                    exit 2
                fi
                SOURCE_REGISTRATION_ONLY=true ;;
            -*)
                echo "Error: unsupported source-add option: $SOURCE_ARGUMENT" >&2
                exit 2 ;;
            *)
                set -- "$@" "$SOURCE_ARGUMENT" ;;
        esac
    done
    if [ "$SOURCE_REGISTRATION_ONLY" = true ]; then
        exec "$ROOT/.venv/bin/python" -I -S -B "$ROOT/scripts/select_sources.py" \
            --codex "$CODEX" --root "$ROOT" --sandbox-home "$SANDBOX_HOME" \
            --language "$SOURCE_LANGUAGE" --registration-only -- "$@"
    fi
    exec "$ROOT/.venv/bin/python" -I -S -B "$ROOT/scripts/select_sources.py" \
        --codex "$CODEX" --root "$ROOT" --sandbox-home "$SANDBOX_HOME" \
        --language "$SOURCE_LANGUAGE" -- "$@"
fi

exec env CODEX_HOME="$SANDBOX_HOME" "$CODEX" sandbox \
    -P research-store -C "$SANDBOX_HOME" -- "$ROOT/research-store" "$@"
