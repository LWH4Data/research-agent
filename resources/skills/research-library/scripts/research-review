#!/bin/sh
set -eu
umask 077

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../../../.." && pwd -P)
MARKER="$ROOT/.research-agent-root"
SANDBOX_HOME="${HOME:?사용자 홈 경로를 확인할 수 없습니다}/.codex/research-library-sandbox"
SANDBOX_CONFIG="$SANDBOX_HOME/config.toml"
SANDBOX_OWNER="$SANDBOX_HOME/.research-agent-owner"

# This is the only public entry point. The private worker subcommand is started
# by the controller with inherited lock descriptors, never by a model task.
case "${1-}" in
    key|submit|prepare|start|status|pause|cancel|resume|cleanup|forget|migrate|delete-document) ;;
    *) echo '오류: 지원되는 research-review 명령을 사용하세요.' >&2; exit 2 ;;
esac

if [ -L "$ROOT/.venv" ] || [ ! -x "$ROOT/.venv/bin/python" ]; then
    echo '오류: Research Agent 설치를 확인할 수 없습니다.' >&2
    exit 1
fi

if [ -L "$MARKER" ] || [ ! -f "$MARKER" ] || \
   [ "$(cat "$MARKER")" != "research-agent-owned-root-v1" ]; then
    echo '오류: Research Agent 설치 표시를 확인할 수 없습니다.' >&2
    exit 1
fi
if [ -L "$SANDBOX_HOME" ] || [ ! -d "$SANDBOX_HOME" ] || \
   [ "$(CDPATH= cd -- "$SANDBOX_HOME" 2>/dev/null && pwd -P)" != "$SANDBOX_HOME" ]; then
    echo '오류: Research Agent 전용 권한 설정 폴더가 안전하지 않습니다.' >&2
    exit 1
fi
for owned_file in "$SANDBOX_CONFIG" "$SANDBOX_OWNER"; do
    if [ -L "$owned_file" ] || [ ! -f "$owned_file" ]; then
        echo '오류: Research Agent 전용 권한 설정을 확인할 수 없습니다.' >&2
        exit 1
    fi
    if stat -f '%l' "$owned_file" >/dev/null 2>&1; then
        links=$(stat -f '%l' "$owned_file")
    else
        links=$(stat -c '%h' "$owned_file")
    fi
    if [ "$links" != "1" ] || \
       [ "$(sed -n '1p' "$owned_file")" != '# research-agent-registration-v1' ] || \
       [ "$(sed -n '2p' "$owned_file")" != "# research-agent-root: $ROOT" ]; then
        echo '오류: Research Agent 전용 권한 설정의 소유권이 다릅니다.' >&2
        exit 1
    fi
done

CODEX=$(command -v codex 2>/dev/null || true)
if [ -z "$CODEX" ] || [ ! -x "$CODEX" ]; then
    echo '오류: Codex 실행 파일을 찾을 수 없습니다.' >&2
    exit 1
fi

# Lifecycle and executor mutations always run inside the existing worker
# profile. Attachment intake uses the existing read-only host transport between
# constrained prepare and submit, because the worker cannot read arbitrary
# attachment locations. Private handoff arguments remain excluded.
case "$1" in
    submit|start)
        "$ROOT/.venv/bin/python" -I -S -B \
            "$ROOT/scripts/review_intake_host.py" --root "$ROOT" \
            --codex "$CODEX" --sandbox-home "$SANDBOX_HOME" "$@"
        ;;
    *)
        env CODEX_HOME="$SANDBOX_HOME" "$CODEX" sandbox \
            -P research-review-worker -C "$SANDBOX_HOME" -- \
            "$ROOT/.venv/bin/python" -I -S -B \
            "$ROOT/scripts/background_lifecycle.py" --root "$ROOT" "$@"
        ;;
esac

# Deliver notices outside the review worker's enclosing sandbox. This helper
# enters a separate profile with writes limited to the notification ledger.
# A notification failure never cancels a successful intake or visual review.
case "$1" in
    submit|start|resume|pause|cancel)
        "$ROOT/.venv/bin/python" -I -S -B \
            "$ROOT/scripts/background_notifier.py" --root "$ROOT" --launch || \
            echo '안내: macOS 알림을 시작하지 못했습니다. 저장된 검토 상태를 확인해 주세요.' >&2
        ;;
esac
